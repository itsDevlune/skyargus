ARGUS_DEBUG=0
ARGUS_DISPATCH=celery
ARGUS_SESSION_ACTIVE_JOBS=0
ARGUS_SESSION_JOBS_PER_HOUR=0
ARGUS_QUEUE_LIMIT=0
SECRET_KEY=replace-with-a-random-secret-at-least-50-characters
